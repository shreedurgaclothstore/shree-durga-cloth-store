{
  "name": "cloth-shop-backend",
  "version": "1.0.0",
  "description": "Cloudflare Worker & Hono API for Cloth Shop O2O Clearance",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/dev-server.ts",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute cloth-shop-db --local --file=./schema.sql",
    "d1:seed": "wrangler d1 execute cloth-shop-db --local --file=./seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "@hono/node-server": "^1.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
